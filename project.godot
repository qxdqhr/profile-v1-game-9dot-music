; 9-Dot Game — Godot. Portrait nine-grid rhythm (Tap / Slide).

config_version=5

[application]

config/name="9-Dot Game"
config/description="Nine-dot Tap/Slide rhythm. Entry /games/9dot-music/."
config/version="0.4.0"
run/main_scene="res://scenes/title.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=360
window/size/viewport_height=640
window/size/mode=0
window/stretch/mode="canvas_items"
window/stretch/aspect="keep"
window/handheld/orientation=1

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
textures/vram_compression/import_etc2_astc=true

[autoload]

Sa2kitCjk="*res://addons/sa2kit_godot/autoload/cjk_boot.gd"
AppSettings="*res://scripts/app_settings.gd"
PlaySession="*res://scripts/play_session.gd"

[gui]

theme/custom_font="res://addons/sa2kit_godot/fonts/SourceHanSansCN-Regular.otf"

[editor_plugins]

enabled=PackedStringArray("res://addons/sa2kit_godot/plugin.cfg")

[input_devices]

pointing/emulate_touch_from_mouse=true
